NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio / Gemini API. Keep this SERVER-SIDE only.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Safety switch: generation APIs are OFF until intentionally enabled.
ENABLE_GEMINI_GENERATION=false

# Veo shares the Gemini API credential.
VEO_MODEL=veo-3.1-fast-generate-preview

# Keep false until billing/access and abuse protection are confirmed.
ENABLE_VEO_GENERATION=false

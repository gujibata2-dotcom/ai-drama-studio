NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio / Gemini API. Keep this SERVER-SIDE only.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Veo shares the Gemini API credential.
VEO_MODEL=veo-3.1-fast-generate-preview

# Safety switch: leave false until you intentionally test paid video generation.
ENABLE_VEO_GENERATION=false
